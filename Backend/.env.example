# Database Configuration
DATABASE_URL=postgresql://<user>:<password>@<HOST>:5432/appointment_booking

# JWT Configuration
SECRET_KEY=3fae44e19c4848600f6614c8241b64f0016b2aa9d10feb87ee49a8b5aaaf9bd5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Email Configuration (Gmail example)
# For Gmail: Use your Gmail address and App Password
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-char password below
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-16-chars
EMAIL_FROM=your-email@gmail.com

# Frontend URL (for reset password links, OTP verification)
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
# Create a Web application OAuth client in Google Cloud Console.
# Add http://localhost:3000/auth/google-callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google-callback

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR

# Server Configuration
DEBUG=True

# API Configuration
API_PREFIX=/api
CORS_ORIGINS=*

# Application
APP_NAME=Appointment Booking System
APP_VERSION=0.1.0
